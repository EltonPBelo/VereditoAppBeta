<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/tv_step_indicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/primary_glow" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_step_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:id="@+id/step_1_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
            <EditText android:id="@+id/et_product_name" android:layout_width="match_parent" android:layout_height="50dp" android:background="@drawable/bg_input_field" android:hint="Nome" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" />
            <EditText android:id="@+id/et_product_brand" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_field" android:hint="Marca" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" />
            <EditText android:id="@+id/et_product_category" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:background="@drawable/bg_input_field" android:hint="Categoria" android:paddingHorizontal="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" />
        </LinearLayout>
        <LinearLayout android:id="@+id/step_2_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="140dp" android:background="@drawable/bg_card_surface" android:gravity="center" android:text="📷\nAdicione fotos" android:textColor="@color/text_secondary" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/step_3_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical" android:visibility="gone">
            <RatingBar android:id="@+id/rating_bar_create" android:layout_width="wrap_content" android:layout_height="wrap_content" android:numStars="5" android:progressTint="@color/accent_star" android:rating="5" android:stepSize="1.0" />
            <EditText android:id="@+id/et_review_headline" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_input_field" android:hint="Título" android:padding="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" />
            <EditText android:id="@+id/et_review_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_input_field" android:gravity="top" android:hint="Avaliação" android:minLines="5" android:padding="14dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_next_step" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="24dp" android:background="@drawable/bg_gradient_primary" android:textAllCaps="false" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</ScrollView>