<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main" android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="40dp">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:layout_margin="16dp" android:background="@drawable/bg_input_field" android:src="@android:drawable/ic_menu_revert" app:tint="@color/text_primary" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        <TextView android:id="@+id/tv_detail_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="@id/btn_back" app:layout_constraintStart_toEndOf="@id/btn_back" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/tv_detail_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_muted" android:textSize="12sp" app:layout_constraintStart_toStartOf="@id/tv_detail_title" app:layout_constraintTop_toBottomOf="@id/tv_detail_title" />
        <ImageView android:id="@+id/iv_detail_hero" android:layout_width="0dp" android:layout_height="260dp" android:layout_marginTop="12dp" android:scaleType="centerCrop" app:layout_constraintTop_toBottomOf="@id/btn_back" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/tv_image_indicator" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="12dp" android:background="#B3000000" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:textColor="@color/white" android:textSize="11sp" app:layout_constraintBottom_toBottomOf="@id/iv_detail_hero" app:layout_constraintEnd_toEndOf="parent" />
        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/iv_detail_avatar" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="16dp" android:layout_marginTop="20dp" android:scaleType="centerCrop" app:shapeAppearanceOverlay="@style/CircleImage" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/iv_detail_hero" />
        <TextView android:id="@+id/tv_detail_reviewer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" app:layout_constraintStart_toEndOf="@id/iv_detail_avatar" app:layout_constraintTop_toTopOf="@id/iv_detail_avatar" />
        <TextView android:id="@+id/tv_detail_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/owner_green" android:textSize="12sp" app:layout_constraintStart_toStartOf="@id/tv_detail_reviewer" app:layout_constraintTop_toBottomOf="@id/tv_detail_reviewer" />
        <LinearLayout android:id="@+id/box_rating" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:background="@drawable/bg_input_field" android:gravity="center" android:orientation="vertical" android:paddingHorizontal="14dp" android:paddingVertical="8dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/iv_detail_avatar">
            <TextView android:id="@+id/tv_detail_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent_star" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:id="@+id/tv_detail_rating_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/accent_star" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/tv_detail_headline" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="20dp" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/box_rating" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/tv_detail_body" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:lineSpacingExtra="5dp" android:textColor="@color/text_secondary" android:textSize="14sp" app:layout_constraintTop_toBottomOf="@id/tv_detail_headline" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <LinearLayout android:id="@+id/ll_pros_cons" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="20dp" android:orientation="horizontal" android:weightSum="2" app:layout_constraintTop_toBottomOf="@id/tv_detail_body" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:background="@drawable/bg_box_owner" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👍 PONTOS POSITIVOS" android:textColor="@color/owner_green" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_pros_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:textColor="@color/text_primary" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/bg_card_surface" android:orientation="vertical" android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👎 PONTOS NEGATIVOS" android:textColor="@color/danger_red" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_cons_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" android:textColor="@color/text_primary" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/tv_comments_header" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginTop="24dp" android:text="Comentários" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/ll_pros_cons" app:layout_constraintStart_toStartOf="parent" />
        <LinearLayout android:id="@+id/ll_tabs_comments" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:orientation="horizontal" android:weightSum="2" app:layout_constraintTop_toBottomOf="@id/tv_comments_header" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
            <Button android:id="@+id/btn_tab_owners" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="4dp" android:backgroundTint="@color/owner_green" android:textAllCaps="false" android:textColor="@color/white" android:textSize="12sp" />
            <Button android:id="@+id/btn_tab_non_owners" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" android:backgroundTint="@color/surface2" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/tv_tab_hint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp" android:background="@drawable/bg_box_owner" android:padding="12dp" android:textColor="@color/owner_green" android:textSize="12sp" app:layout_constraintTop_toBottomOf="@id/ll_tabs_comments" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_comments" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" app:layout_constraintTop_toBottomOf="@id/tv_tab_hint" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <EditText android:id="@+id/et_new_comment" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_input_field" android:minLines="2" android:padding="12dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="13sp" app:layout_constraintTop_toBottomOf="@id/rv_comments" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_send_comment" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginHorizontal="16dp" android:layout_marginTop="10dp" android:background="@drawable/bg_gradient_primary" android:text="Publicar Comentário" android:textAllCaps="false" android:textColor="@color/white" android:textStyle="bold" app:layout_constraintTop_toBottomOf="@id/et_new_comment" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>