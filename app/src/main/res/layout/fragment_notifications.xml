    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_notifications" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="12dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/ll_notif_tabs" />
</androidx.constraintlayout.widget.ConstraintLayout>