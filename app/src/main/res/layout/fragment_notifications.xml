<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main" android:padding="16dp">
    <TextView android:id="@+id/tv_notif_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Alertas" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <TextView android:id="@+id/btn_mark_all_read" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Marcar tudo como lido" android:textColor="@color/primary_glow" android:textSize="13sp" android:textStyle="bold" app:layout_constraintBottom_toBottomOf="@id/tv_notif_title" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/tv_notif_title" />
    <LinearLayout android:id="@+id/ll_notif_tabs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_notif_title">
        <Button android:id="@+id/btn_notif_all" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:backgroundTint="@color/primary" android:text="Todos" android:textAllCaps="false" android:textColor="@color/white" />
