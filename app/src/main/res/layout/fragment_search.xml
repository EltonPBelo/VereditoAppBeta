<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_main" android:padding="16dp">
    <TextView android:id="@+id/tv_search_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Buscar" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
    <EditText android:id="@+id/et_search" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginTop="12dp" android:layout_marginEnd="10dp" android:background="@drawable/bg_input_field" android:hint="Buscar..." android:paddingHorizontal="14dp" android:singleLine="true" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="14sp" app:layout_constraintEnd_toStartOf="@id/btn_open_filters" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_search_title" />
    <Button android:id="@+id/btn_open_filters" android:layout_width="wrap_content" android:layout_height="48dp" android:backgroundTint="@color/surface2" android:text="Filtros" android:textAllCaps="false" android:textColor="@color/primary_glow" app:layout_constraintBottom_toBottomOf="@id/et_search" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/et_search" />
    <TextView android:id="@+id/tv_trending_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="🔥 EM ALTA AGORA: Sony XM5 • iPhone 15 • OLED C3" android:textColor="@color/text_muted" android:textSize="12sp" android:textStyle="bold" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/et_search" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rv_search_results" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="12dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tv_trending_label" />
</androidx.constraintlayout.widget.ConstraintLayout>