<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Veredito" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_glow</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Veredito.BottomSheetDialog</item>
    </style>

    <style name="ThemeOverlay.Veredito.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Veredito.BottomSheet</item>
    </style>

    <style name="Widget.Veredito.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>